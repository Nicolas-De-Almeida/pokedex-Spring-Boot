# Copie este arquivo para backend/.env e preencha com a connection string do seu cluster no MongoDB Atlas.
# O arquivo .env NÃO deve ser enviado ao GitHub (ele já está no .gitignore).
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=pokedex

# Opcionais
# PORT=8080
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# SEED_RESET=false
